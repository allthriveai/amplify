{
  "vaultPath": "~/path/to/your/obsidian-vault",
  "paths": {
    "sources": "Sources",
    "wiki": "Wiki",
    "meetings": "Sources/Meetings",
    "audio": "Sources/Audio",
    "stories": "Work/Stories",
    "strategyDocs": "Work/Strategy",
    "people": "Wiki/Entities",
    "voice": "Amplify/Voice.md",
    "amplifyStructures": "Amplify/Structures",
    "amplifyHooks": "Amplify/Hooks",
    "amplifyPersuasion": "Amplify",
    "signals": "Amplify/Signals",
    "memory": "Amplify/Memory",
    "brand": "Amplify/Brand"
  },
  "brand": {
    "name": "Your Brand",
    "tagline": "What you do in one line",
    "domain": "yourdomain.com",
    "colors": {
      "primary": "#2e4a6e",
      "secondary": "#389590",
      "text": "#1a2538",
      "accent": "#e0a53c",
      "background": "#ece6de",
      "neutral": "#d1c9be"
    },
    "fonts": {
      "body": "Inter"
    }
  },
  "studio": {
    "heygenApiKey": "",
    "heygenAvatarId": "",
    "heygenVoiceId": "",
    "elevenlabsApiKey": "",
    "elevenlabsVoiceId": "",
    "listenVoiceId": "",
    "googleApiKey": ""
  },
  "capture": {
    "obsWebsocketUrl": "ws://localhost:4455",
    "obsWebsocketPassword": "",
    "defaultScene": "Amplify: Screen + Camera",
    "hotkeys": {
      "startRecording": "OBS_KEY_F9",
      "stopRecording": "OBS_KEY_F10",
      "sceneScreenCamera": "OBS_KEY_F5",
      "sceneScreenOnly": "OBS_KEY_F6",
      "sceneCameraOnly": "OBS_KEY_F7"
    }
  }
}
