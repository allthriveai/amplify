{
  "name": "amplify",
  "version": "0.1.0",
  "description": "Turn your Obsidian second brain into published content. Reads your vault, writes nothing of its own.",
  "type": "module",
  "bin": {
    "amplify": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "serve": "tsx src/mcp/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "check:personal": "node tools/check-personal.mjs",
    "check:vault": "npm run build && node tools/check-vault.mjs",
    "lint:wiki": "npm run build && node tools/lint-wiki.mjs",
    "prepublishOnly": "npm run check:personal && npm run lint && npm run test:run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "obsidian",
    "second-brain",
    "content-flywheel",
    "llm-wiki",
    "remotion",
    "elevenlabs",
    "heygen",
    "digital-twin",
    "mcp",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allthriveai/amplify.git"
  },
  "homepage": "https://github.com/allthriveai/amplify#readme",
  "author": "Allie Jones (https://github.com/allierays)",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@remotion/captions": "4.0.431",
    "@remotion/cli": "^4.0.431",
    "@remotion/google-fonts": "^4.0.431",
    "@remotion/install-whisper-cpp": "4.0.431",
    "@remotion/media": "^4.0.431",
    "@remotion/transitions": "^4.0.431",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "obs-websocket-js": "^5.0.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.431"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
